# Log files
**/*.log

# Neovim files & plugins
.local/share/nvim
.local/state

# Hyprland runtime-generated files
.config/hypr/wallpaper_effects/
.config/hypr/.cache/

# wallust outputs: regenerated from ~/.config/wallust/templates on every
# wallpaper change. Track the templates, never the rendered palettes.
.config/hypr/wallust/wallust-hyprland.conf
.config/kitty/wallust.conf
.config/rofi/wallust/
.config/waybar/wallust/
.config/helix/themes/
.config/cava/config
.config/dunst/dunstrc
.config/qt5ct/colors/colors-qt5.conf
.config/qt6ct/colors/colors-qt6.conf

# wallust runtime pointers into the wallpaper tree
.config/rofi/.current_wallpaper

# waybar layout/style selection symlinks: these point at your chosen entry
# inside configs/ and style/. Both targets are tracked, so the symlinks are too.
# (listed as documentation, deliberately NOT ignored)

# App-generated configs: rewritten wholesale by their owning tool.
# MangoHud.conf carries a "File Generated by Goverlay" banner; the autostart
# entries embed an AppImage mount dir (/tmp/.mount_*) that changes per launch.
.config/MangoHud/
.config/autostart/
.config/goverlay/

# Editor/TUI runtime state (config files alongside these ARE tracked)
.config/micro/backups/
.config/micro/buffers/

# Encrypted-notes app: contains an argon2 PIN hash and a randomized /tmp
# notes_dir. Do not track.
.config/ryokan/

# Tool-generated caches
.config/autostart/mimeinfo.cache
.config/configstore/

# Private per-project paths (a local Rust project you build parsers against)
.config/tree-sitter/

# Secrets: credential stores and forge API tokens
.config/gh/
.config/glab-cli/
.config/tea/

# Git identity: name, email, and GPG signing key. The tracked
# .config/git/config pulls this in via [include], so set it up after cloning.
.config/git/config.local

# Not tracking: per-project and personal-tool paths
.config/lyrebird/
